# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 环境与密钥（样例文件放行进仓库，真实配置永不入库）
.env
.env.*
!backend/.env.example
!frontend/.env.example
*.key

# 防误提交：数据备份 / 导出文件永不入库（真实数据是私人资产，只存仓库外；
# 根目录任何 .sql 都视为误放——唯一的合法 SQL 是 backend 迁移文件）
/*.sql
*.dump
*.bak

# 个人收款码是私有资产，不进公开仓库；部署时独立注入 frontend/public/support/
# （见该目录 README 与 docs/deployment/production-deployment.md）
frontend/public/support/*.jpg

# 生产部署私有文件：真实环境变量、私有资产、数据库备份（见 deploy/env.production.example）
deploy/env.production
deploy/private-assets/
backups/

# 依赖与构建产物（编码阶段使用）
node_modules/
.next/
out/
target/
build/
dist/

# IDE
.idea/
.vscode/
*.iml
