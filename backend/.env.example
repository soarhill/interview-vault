# 后端环境变量样例——复制为真实配置并填入实际值；真实 .env* 永不入库（见 .gitignore）。
# 生产还要求 SPRING_PROFILES_ACTIVE=prod，且不接受任何开发默认值（见 docs/deployment/production-deployment.md）。

IV_DB_URL=jdbc:postgresql://localhost:5433/interviewvault
IV_DB_USER=postgres
IV_DB_PASSWORD=dev

IV_GITHUB_CLIENT_ID=placeholder
IV_GITHUB_CLIENT_SECRET=placeholder

IV_SERVER_PORT=8080
IV_CORS_ORIGINS=http://localhost:3000
IV_LOGIN_SUCCESS_REDIRECT=http://localhost:3000

# 管理员 GitHub 数字 ID 白名单（逗号分隔）
IV_ADMIN_GITHUB_IDS=
