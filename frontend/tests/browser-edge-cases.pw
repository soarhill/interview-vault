async (page) => {
  const base = new URL(page.url()).origin;
  const checks = [];
  page.setDefaultTimeout(12000);
  const check = (ok, label) => { if (!ok) throw new Error(label); checks.push(label); };
  const goto = async (actor, path, selector) => { await actor.goto(base + path); if (selector) await actor.locator(selector).first().waitFor(); };
  const login = async (actor, role) => { await actor.getByRole('button', { name: 'GitHub 登录', exact: true }).first().click(); await actor.getByRole('button', { name: role === 'ADMIN' ? '以管理员体验' : '以投稿人体验', exact: true }).click(); await actor.getByLabel('用户菜单').waitFor(); };
  let step = '';
  try {
    if (await page.getByRole('dialog').count()) await page.getByRole('button', { name: '关闭', exact: true }).click();
    step = 'mobile header and image loading';
    await page.setViewportSize({ width: 375, height: 812 }); await goto(page, '/', '.filter-bar');
    const header = await page.evaluate(() => ({ header: document.querySelector('.site-header').getBoundingClientRect().bottom, nav: document.querySelector('.site-navigation').getBoundingClientRect().bottom }));
    check(header.nav <= header.header, 'Phone two-row navigation stays inside sticky header');
    await page.goto(base + '/about'); await page.getByText('查看赞赏码').click();
    await page.waitForFunction(() => [...document.querySelectorAll('details img')].every(img => img.complete && img.naturalWidth > 0));
    await page.screenshot({ path: 'output/playwright/about-mobile.png' });
    check(true, 'Both original QR images finish loading');
    step = 'list scroll restoration';
    await page.setViewportSize({ width: 1440, height: 1000 }); await goto(page, '/', '.filter-bar');
    await page.locator('.card-main-link').nth(15).scrollIntoViewIfNeeded();
    const before = await page.evaluate(() => scrollY);
    await page.locator('.card-main-link').nth(15).click(); await page.locator('.detail-heading').waitFor();
    await page.getByRole('link', { name: '返回列表', exact: true }).click(); await page.locator('.filter-bar').waitFor();
    await page.waitForFunction(expected => Math.abs(scrollY - expected) <= 3, before);
    check(before > 300, 'List detail return restores scroll position');
    step = 'round navigation after stable follow-up entry and true clipboard feedback';
    await goto(page, '/?q=Lua', '.match-link'); await page.locator('.match-link').first().click(); await page.locator('.detail-heading').waitFor();
    await page.waitForFunction(() => document.activeElement?.hasAttribute('data-follow-up'));
    await page.locator('.round-nav a').nth(1).click();
    await page.waitForFunction(() => document.activeElement?.id.startsWith('round-'));
    check(await page.getByText('原定位问题已变化', { exact: true }).count() === 0, 'Round navigation ignores stale followUpId');
    await page.evaluate(() => Object.defineProperty(navigator, 'clipboard', { configurable: true, value: { writeText: text => new Promise(resolve => { window.copyPayload = text; window.finishCopy = resolve; }) } }));
    await page.getByRole('button', { name: '复制 Q1', exact: true }).first().click();
    check(await page.getByRole('button', { name: '复制 Q1', exact: true }).first().innerText() === '复制中', 'Clipboard success waits for the real promise');
    await page.evaluate(() => window.finishCopy()); await page.getByRole('button', { name: '复制 Q1，已复制', exact: true }).waitFor();
    check(await page.evaluate(() => window.copyPayload) === 'Redis 分布式锁怎么实现？', 'Copied text excludes UI labels');
    step = 'dirty logout cancellation and confirmation';
    await login(page, 'USER');
    await goto(page, '/me/interviews/new', '.interview-editor');
    await page.getByRole('textbox', { name: '问题 1', exact: true }).first().fill('退出登录前尚未保存的问题');
    await page.getByLabel('用户菜单').click(); await page.getByRole('button', { name: '退出登录', exact: true }).click();
    await page.getByRole('dialog').waitFor(); await page.getByRole('button', { name: '继续编辑', exact: true }).click();
    check(await page.getByRole('textbox', { name: '问题 1', exact: true }).first().inputValue() === '退出登录前尚未保存的问题', 'Cancel logout preserves dirty text and identity');
    if ((await page.locator('.user-menu').getAttribute('open')) === null) await page.getByLabel('用户菜单').click();
    await page.getByRole('button', { name: '退出登录', exact: true }).click(); await page.getByRole('dialog').waitFor();
    await page.getByRole('button', { name: '放弃修改并离开', exact: true }).click();
    await page.getByRole('heading', { name: '登录后，分享你的面试经历' }).waitFor();
    check(true, 'Confirmed logout clears session only after explicit discard');
    await login(page, 'USER');
    const admin = await page.context().newPage(); admin.setDefaultTimeout(12000); await goto(admin, '/'); await login(admin, 'ADMIN');
    step = 'historical empty round, precision and source-preserving direct edit';
    await goto(admin, '/admin/interviews/123/edit', '.interview-editor');
    await admin.getByRole('textbox', { name: '部门 可选', exact: true }).fill('管理员保真修正部门');
    await admin.getByRole('button', { name: '保存并更新公开内容', exact: true }).click();
    await admin.getByText('正式内容已更新，修改前版本已留存审计。', { exact: true }).waitFor();
    check(await admin.getByRole('textbox', { name: /^来源 [12]$/ }).count() === 2, 'Canonical governance preserves both source links');
    await goto(page, '/interview/123', '.detail-heading');
    check((await page.locator('.detail-heading').innerText()).includes('管理员保真修正部门'), 'Admin ordinary edits save despite an authentic empty HR round');
    check(await page.locator('#round-57 .question-card').count() === 0, 'Empty HR round is retained without invented questions');
    check(await page.locator('.source-links a').count() === 2, 'Public detail retains full multiple sources');
    check((await page.locator('.detail-heading').innerText()).includes('2026年9月'), 'Public date remains month precision after governance');
    step = 'direct-edit change request race';
    await goto(admin, '/admin/interviews/1004/edit', '.interview-editor');
    await admin.getByRole('textbox', { name: '部门 可选', exact: true }).fill('管理员尚未保存的直改');
    await goto(page, '/me/interviews/1004/change', '.interview-editor');
    await page.getByRole('textbox', { name: '部门 可选', exact: true }).fill('作者新的修改申请');
    await page.getByRole('button', { name: '提交修改申请', exact: true }).click(); await page.getByText('修改申请已提交。审核通过前，公开面经继续展示原版本。', { exact: true }).waitFor();
    await admin.getByRole('button', { name: '保存并更新公开内容', exact: true }).click();
    await admin.getByText('请先处理待审核的变更申请', { exact: true }).waitFor();
    check(await admin.getByRole('textbox', { name: '部门 可选', exact: true }).inputValue() === '管理员尚未保存的直改', 'CHANGE_REQUEST_CONFLICT differs from version conflict and preserves input');
    step = 'author version conflict';
    const author = await page.context().newPage(); author.setDefaultTimeout(12000); await goto(author, '/'); await login(author, 'USER');
    await goto(author, '/me/interviews/1002/edit', '.interview-editor');
    await author.getByRole('textbox', { name: '部门 可选', exact: true }).fill('作者A未保存的内容');
    await goto(page, '/me/interviews/1002/edit', '.interview-editor');
    await page.getByRole('textbox', { name: '部门 可选', exact: true }).fill('作者B并发保存'); await page.getByRole('button', { name: '保存更新', exact: true }).click(); await page.getByText('已保存，审核员将看到这次更新。', { exact: true }).waitFor();
    await author.getByRole('button', { name: '保存更新', exact: true }).click(); await author.getByText('当前内容已经发生变化', { exact: true }).waitFor();
    check(await author.getByRole('textbox', { name: '部门 可选', exact: true }).inputValue() === '作者A未保存的内容', 'Author 409 does not clear local text');
    await author.getByRole('button', { name: '加载最新版本并对比', exact: true }).click(); await author.getByText('查看服务器最新内容').waitFor();
    check(await author.getByRole('textbox', { name: '部门 可选', exact: true }).inputValue() === '作者A未保存的内容', 'Author conflict refresh keeps text for explicit comparison');
    await author.getByRole('button', { name: '已对比，保留我的输入继续编辑', exact: true }).click();
    await author.getByRole('button', { name: '保存更新', exact: true }).click(); await author.getByText('已保存，审核员将看到这次更新。', { exact: true }).waitFor();
    check(true, 'Explicit conflict reconciliation saves against current version');
    await author.close();
    // Discard the test-only blocked administrator edit through its actual navigation guard.
    await admin.getByRole('link', { name: '审核', exact: true }).click(); await admin.getByRole('button', { name: '放弃修改并离开', exact: true }).click(); await admin.waitForURL('**/admin/reviews');
    await admin.setViewportSize({ width: 1440, height: 1000 }); await goto(admin, '/admin/reviews/1002'); await admin.getByText('提交时间').first().waitFor(); await admin.screenshot({ path: 'output/playwright/review-desktop.png' });
    await admin.close(); await goto(page, '/', '.filter-bar');
    return { passed: checks.length, checks };
  } catch (error) { throw new Error(`${step}: ${error.message}`); }
}
