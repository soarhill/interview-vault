async (page) => {
  const base = new URL(page.url()).origin;
  const passed = [];
  page.setDefaultTimeout(12000);
  const check = (ok, name) => { if (!ok) throw new Error(name); passed.push(name); };
  const goto = async (actor, path, selector) => { await actor.goto(base + path); if (selector) await actor.locator(selector).first().waitFor(); };
  const noOverflow = actor => actor.evaluate(() => document.documentElement.scrollWidth <= innerWidth);
  const login = async (actor, role) => {
    await actor.getByRole('button', { name: 'GitHub 登录', exact: true }).first().click();
    await actor.getByRole('button', { name: role === 'ADMIN' ? '以管理员体验' : '以投稿人体验', exact: true }).click();
    await actor.getByLabel('用户菜单').waitFor();
  };
  let step = '';
  try {
    step = 'public search, filters, pagination';
    await goto(page, '/', '.filter-bar');
    await page.evaluate(() => { localStorage.clear(); sessionStorage.clear(); });
    await page.reload(); await page.locator('.filter-bar').waitFor();
    await page.setViewportSize({ width: 1440, height: 1000 });
    check(await page.locator('.interview-card').count() === 24, 'Desktop pagination uses canonical size');
    await page.getByRole('button', { name: '下一页', exact: true }).click();
    await page.waitForURL('**/?page=2'); await page.locator('.filter-bar').waitFor();
    await page.getByRole('group', { name: '公司', exact: true }).getByRole('button', { name: /^字节跳动/ }).click();
    await page.waitForURL(url => url.searchParams.get('companyId') === '1'); await page.locator('.filter-bar').waitFor();
    check(!new URL(page.url()).searchParams.has('page'), 'Changing filters resets pagination');
    await page.getByRole('group', { name: '岗位', exact: true }).getByRole('button', { name: /^后端开发/ }).click();
    await page.waitForURL(url => url.searchParams.has('positionCategory')); await page.locator('.filter-bar').waitFor();
    await page.getByRole('group', { name: '招聘类型', exact: true }).getByRole('button', { name: /^校招/ }).click();
    await page.waitForURL(url => url.searchParams.get('recruitType') === 'CAMPUS'); await page.locator('.filter-bar').waitFor();
    const categoryParam = new URL(page.url()).searchParams.get('positionCategory');
    await page.reload(); await page.locator('.filter-bar').waitFor();
    check(Boolean(categoryParam) && new URL(page.url()).searchParams.get('positionCategory') === categoryParam, 'Filter state survives reload');
    await page.locator('#results').getByRole('button', { name: '重置', exact: true }).click();
    await page.waitForURL(base + '/'); await page.locator('.filter-bar').waitFor();
    await page.getByRole('searchbox').fill('Redis'); await page.getByRole('searchbox').press('Enter');
    await page.waitForURL('**/?q=Redis'); await page.locator('.filter-bar').waitFor();
    check(true, 'Search submits on Enter');
    await page.locator('#results').getByRole('button', { name: '重置', exact: true }).click();
    await page.waitForURL(base + '/'); await page.locator('.filter-bar').waitFor();
    await page.getByRole('searchbox').fill('Lua'); await page.getByRole('button', { name: '搜索', exact: true }).click();
    await page.waitForURL('**/?q=Lua'); await page.locator('.match-link').first().waitFor();
    const href = await page.locator('.match-link').first().getAttribute('href');
    check(href.includes('followUpId=') && href.includes('#question-'), 'Follow-up links carry both stable IDs');
    step = 'detail, anchor, copy and states';
    await page.locator('.match-link').first().click(); await page.locator('.detail-heading').waitFor();
    await page.waitForFunction(() => document.activeElement?.hasAttribute('data-follow-up'));
    check(await page.locator('.question-card mark').count() > 0, 'Detail highlights search visually');
    const anchor = await page.evaluate(() => ({ top: document.activeElement.getBoundingClientRect().top, offset: document.querySelector('.round-nav')?.getBoundingClientRect().bottom ?? 0 }));
    check(anchor.top >= anchor.offset - 2, 'Follow-up anchor clears sticky navigation');
    await page.evaluate(() => Object.defineProperty(navigator, 'clipboard', { configurable: true, value: { writeText: async () => { throw new Error('Denied'); } } }));
    await page.getByRole('button', { name: '复制 Q1 整组', exact: true }).first().click();
    await page.getByRole('dialog').waitFor();
    check((await page.locator('#manual-copy-text').inputValue()).includes('追问：'), 'Failed clipboard provides complete manual text');
    await page.getByRole('button', { name: '关闭', exact: true }).click();
    await page.getByRole('link', { name: '返回列表', exact: true }).click();
    await page.waitForURL('**/?q=Lua'); await page.locator('.filter-bar').waitFor();
    await goto(page, '/interview/123#question-999999', '.detail-heading');
    await page.getByText('原定位问题已变化', { exact: true }).waitFor();
    check((await page.locator('.detail-heading').innerText()).includes('2026年9月'), 'Month precision retains month display');
    await goto(page, '/interview/999999'); await page.getByRole('heading', { name: '面经不存在', exact: true }).waitFor();
    await goto(page, '/?q=__error__'); await page.getByRole('heading', { name: '面经读取失败' }).waitFor();
    await goto(page, '/?q=无此面试问题'); await page.getByRole('heading', { name: '暂时没有找到符合条件的面经' }).waitFor();
    check(true, 'Public missing, empty, error and invalid-anchor states');
    step = 'authentication';
    await goto(page, '/me/interviews/new'); await page.getByRole('heading', { name: '登录后，分享你的面试经历' }).waitFor();
    await login(page, 'USER'); await page.getByRole('heading', { name: '记录一段真实的面试经历' }).waitFor();
    await goto(page, '/admin/reviews'); await page.getByRole('heading', { name: '权限不足' }).waitFor();
    check(true, 'Anonymous login prompt and USER admin permission denied');
    const admin = await page.context().newPage(); admin.setDefaultTimeout(12000);
    await goto(admin, '/'); await login(admin, 'ADMIN');
    step = 'new submission and incomplete draft';
    await goto(page, '/me/interviews/new', '.interview-editor');
    await page.getByRole('button', { name: '提交审核', exact: true }).click(); await page.locator('.editor-error-summary').waitFor();
    await page.getByRole('textbox', { name: '部门 可选', exact: true }).fill('未完成草稿');
    await page.getByRole('button', { name: '保存草稿', exact: true }).click();
    await page.waitForURL(/\/me\/interviews\/\d+\/edit$/); await page.locator('.interview-editor').waitFor();
    const id = Number(new URL(page.url()).pathname.split('/')[3]);
    check(await page.getByRole('textbox', { name: '部门 可选', exact: true }).inputValue() === '未完成草稿', 'Draft accepts incomplete content and retains canonical baseline');
    step = 'form structure and dirty navigation';
    await page.getByPlaceholder('如 字节跳动').fill('Beta 测试公司');
    await page.getByPlaceholder('如 Java 后端开发').fill('Beta 测试岗位');
    await page.getByRole('searchbox', { name: '搜索标签', exact: true }).fill('Beta 测试标签');
    await page.getByRole('button', { name: /新增标签「Beta 测试标签」/ }).click();
    await page.getByRole('combobox', { name: '招聘类型 *', exact: true }).click();
    await page.getByRole('option', { name: '校招', exact: true }).click();
    await page.getByRole('textbox', { name: '部门 可选', exact: true }).fill('平台研发');
    await page.getByRole('textbox', { name: '问题 1', exact: true }).first().fill('Redis 锁如何保证正确性？');
    await page.getByRole('button', { name: /添加追问/ }).first().click();
    await page.getByPlaceholder('面试官接着问了什么？').first().fill('业务超时怎么办？');
    await page.getByRole('link', { name: '我的投稿', exact: true }).click(); await page.getByRole('dialog').waitFor();
    await page.getByRole('button', { name: '继续编辑', exact: true }).click();
    check(await page.getByRole('textbox', { name: '问题 1', exact: true }).first().inputValue() === 'Redis 锁如何保证正确性？', 'Cancel leaving preserves dirty form');
    await page.evaluate(() => history.back()); await page.getByRole('dialog').waitFor();
    await page.getByRole('button', { name: '继续编辑', exact: true }).click();
    check(await page.getByRole('textbox', { name: '部门 可选', exact: true }).inputValue() === '平台研发', 'Browser Back cancellation preserves inputs');
    await page.getByRole('button', { name: '提交审核', exact: true }).click();
    await page.waitForURL(/\/me\/interviews\/submitted/); await page.getByRole('heading', { name: '提交成功，感谢分享！' }).waitFor();
    await goto(page, `/me/interviews/${id}/edit`, '.interview-editor');
    check(await page.getByRole('button', { name: '保存更新', exact: true }).count() === 1, 'Submission becomes editable pending review');
    step = 'candidate resolution and publication';
    await goto(admin, `/admin/reviews/${id}`);
    await admin.getByRole('region', { name: '公司候选：Beta 测试公司' }).waitFor();
    for (const [kind, value] of [['公司', 'Beta 测试公司'], ['岗位', 'Beta 测试岗位'], ['标签', 'Beta 测试标签']]) {
      const card = admin.getByRole('region', { name: `${kind}候选：${value}` });
      await card.getByRole('button', { name: new RegExp(`创建新${kind}`) }).click();
      if (kind === '岗位') {
        await card.getByLabel('岗位方向（决定首页筛选归属）').selectOption('后端开发');
      }
      await card.getByRole('button', { name: '确认创建', exact: true }).click();
      await card.waitFor({ state: 'detached' });
    }
    await admin.getByRole('button', { name: '发布面经', exact: true }).click();
    await admin.waitForURL(/\/admin\/reviews\?done=/);
    await admin.getByText('面经已发布，现在可以被搜索和阅读。', { exact: true }).waitFor();
    check(true, 'Three candidates resolve with returned versions and then publish');
    await goto(page, `/interview/${id}`, '.detail-heading');
    check((await page.locator('.detail-heading').innerText()).includes('Beta 测试岗位'), 'Published contribution enters public detail');
    step = 'rejected author edit and resubmit';
    await goto(page, '/me/interviews/1003/edit', '.interview-editor');
    await page.getByRole('textbox', { name: '部门 可选', exact: true }).fill('补充后重提');
    await page.getByRole('button', { name: '保存草稿', exact: true }).click();
    await page.getByText('已保存草稿，可以稍后继续填写。', { exact: true }).waitFor();
    await page.getByRole('button', { name: '提交审核', exact: true }).click();
    await page.waitForURL(/\/me\/interviews\/submitted/); await page.getByRole('heading', { name: '提交成功，感谢分享！' }).waitFor();
    await goto(admin, '/admin/reviews/1003');
    await admin.getByRole('button', { name: '拒绝投稿', exact: true }).waitFor();
    await admin.getByRole('button', { name: '拒绝投稿', exact: true }).click();
    await admin.getByRole('textbox', { name: '拒绝原因', exact: true }).fill('请补充来源');
    await admin.getByRole('button', { name: '确认拒绝', exact: true }).click();
    await admin.waitForURL(/\/admin\/reviews\?done=/);
    await admin.getByText('已拒绝投稿，作者可以补充后重新提交。', { exact: true }).waitFor();
    check(true, 'Rejected edit returns to draft, resubmits and records review reason');
    step = 'concurrent author/admin version conflict';
    await goto(admin, '/admin/reviews/1002');
    await admin.getByRole('button', { name: '编辑内容', exact: true }).click();
    await admin.getByRole('textbox', { name: '部门 可选', exact: true }).fill('管理员未保存输入');
    await goto(page, '/me/interviews/1002/edit', '.interview-editor');
    await page.getByRole('textbox', { name: '部门 可选', exact: true }).fill('作者并发更新');
    await page.getByRole('button', { name: '保存更新', exact: true }).click();
    await page.getByText('已保存，审核员将看到这次更新。', { exact: true }).waitFor();
    await admin.getByRole('button', { name: '保存并返回审核', exact: true }).click();
    await admin.getByText('当前内容已经发生变化', { exact: true }).waitFor();
    check(await admin.getByRole('textbox', { name: '部门 可选', exact: true }).inputValue() === '管理员未保存输入', '409 retains administrator unsaved input');
    check(await admin.getByRole('button', { name: '发布面经', exact: true }).isDisabled(), 'Version conflict stops review mutations');
    await admin.getByRole('button', { name: '读取最新版本', exact: true }).click();
    await admin.getByRole('button', { name: '已核对，继续审核', exact: true }).waitFor();
    check(await admin.getByRole('textbox', { name: '部门 可选', exact: true }).inputValue() === '管理员未保存输入', 'Conflict refresh compares without clearing local input');
    await admin.getByRole('button', { name: '已核对，继续审核', exact: true }).click();
    await admin.getByRole('button', { name: '保存并返回审核', exact: true }).click();
    await admin.getByText('审核内容已保存。', { exact: true }).waitFor();
    step = 'change UPDATE and pending direct-edit block';
    await goto(page, `/me/interviews/${id}/change`, '.interview-editor');
    await page.getByRole('textbox', { name: '部门 可选', exact: true }).fill('修改申请目标部门');
    await page.getByRole('button', { name: '提交修改申请', exact: true }).click();
    await page.getByText('修改申请已提交。审核通过前，公开面经继续展示原版本。', { exact: true }).waitFor();
    await goto(page, `/me/interviews/${id}/change?type=DELETE`, '#deletion-reason');
    check(await page.getByRole('heading', { name: '申请删除已发布内容', exact: true }).isVisible(), 'Explicit DELETE entry opens deletion form despite pending UPDATE');
    check(await page.getByText('修改申请已提交。审核通过前，公开面经继续展示原版本。', { exact: true }).count() === 0, 'DELETE form does not retain UPDATE success feedback');
    await goto(admin, `/admin/interviews/${id}/edit`, '.workspace-page');
    await admin.getByText('这份面经有待处理的变更申请', { exact: true }).waitFor();
    check(await admin.getByRole('button', { name: /保存/ }).last().isDisabled(), 'Pending request blocks direct administrator edits');
    await goto(admin, '/admin/change-requests');
    await admin.getByRole('link', { name: /Beta 测试公司/ }).first().click();
    await admin.getByRole('button', { name: '批准修改', exact: true }).waitFor();
    await admin.getByRole('button', { name: '批准修改', exact: true }).click();
    await admin.getByText('该申请已批准', { exact: true }).waitFor();
    await goto(page, `/interview/${id}`, '.detail-heading');
    check((await page.locator('.detail-heading').innerText()).includes('修改申请目标部门'), 'Approved UPDATE applies target version');
    step = 'change rejection and DELETE approval';
    await goto(page, `/me/interviews/${id}/change`, '.interview-editor');
    await page.getByRole('textbox', { name: '部门 可选', exact: true }).fill('这份修改将拒绝');
    await page.getByRole('button', { name: '提交修改申请', exact: true }).click();
    await page.getByText('修改申请已提交。审核通过前，公开面经继续展示原版本。', { exact: true }).waitFor();
    await goto(admin, '/admin/change-requests'); await admin.getByRole('link', { name: /Beta 测试公司/ }).first().click();
    await admin.getByRole('button', { name: '拒绝申请', exact: true }).click(); await admin.getByText('该申请已拒绝', { exact: true }).waitFor();
    await goto(page, `/interview/${id}`, '.detail-heading');
    check((await page.locator('.detail-heading').innerText()).includes('修改申请目标部门'), 'Rejecting UPDATE preserves public content');
    await goto(page, `/me/interviews/${id}/change?type=DELETE`);
    await page.getByRole('button', { name: '提交删除申请', exact: true }).click();
    await page.getByText('请填写申请删除的原因。', { exact: true }).waitFor();
    check(await page.locator('#deletion-reason').getAttribute('maxlength') === '500', 'DELETE reason respects the API length limit');
    await page.getByRole('textbox', { name: '删除原因', exact: true }).fill('希望撤回这份测试面经');
    await page.getByRole('button', { name: '提交删除申请', exact: true }).click();
    await page.getByText('删除申请已提交。管理员批准后，这份面经将下架。', { exact: true }).waitFor();
    await page.getByRole('button', { name: '更新这份申请', exact: true }).click();
    check(await page.getByRole('textbox', { name: '删除原因', exact: true }).inputValue() === '希望撤回这份测试面经', 'Editing pending DELETE retains its reason');
    check(await page.getByText('删除申请已提交。管理员批准后，这份面经将下架。', { exact: true }).count() === 0, 'Reopening DELETE clears stale success feedback');
    await goto(admin, '/admin/change-requests'); await admin.getByRole('link', { name: /Beta 测试公司/ }).first().click();
    await admin.getByRole('button', { name: '批准删除…', exact: true }).click();
    await admin.getByRole('button', { name: '确认批准删除', exact: true }).click(); await admin.getByText('该申请已批准', { exact: true }).waitFor();
    await goto(page, `/interview/${id}`); await page.getByRole('heading', { name: '该面经已下架', exact: true }).waitFor();
    check(true, 'DELETE approval produces distinct INTERVIEW_REMOVED state');
    step = 'pure draft delete';
    await goto(page, '/me/interviews', '.workspace-list-card');
    const draftsBefore = await page.locator('.workspace-list-card').count();
    await page.getByRole('button', { name: '删除草稿', exact: true }).first().click();
    await page.getByRole('dialog').getByRole('button', { name: '删除草稿', exact: true }).click();
    await page.waitForFunction(expected => document.querySelectorAll('.workspace-list-card').length === expected, draftsBefore - 1);
    check(true, 'Pure draft deletion follows backend action');
    step = 'PC and phone responsive flows, support, reduced motion';
    await admin.getByRole('link', { name: '浏览面经', exact: true }).click(); await admin.locator('.filter-bar').waitFor();
    await page.setViewportSize({ width: 375, height: 812 }); await goto(page, '/', '.filter-bar');
    check(await noOverflow(page), 'Phone list has no horizontal overflow');
    check(await page.locator('.card-grid').evaluate(el => getComputedStyle(el).gridTemplateColumns.split(' ').length) === 1, 'Phone list uses one column');
    await page.getByRole('combobox', { name: '岗位筛选', exact: true }).click(); await page.getByRole('option', { name: /^后端开发/ }).click();
    await page.waitForURL(url => /^[1-9]\d*$/.test(url.searchParams.get('positionCategory') ?? '')); await page.locator('.filter-bar').waitFor();
    await page.screenshot({ path: 'output/playwright/list-mobile.png', fullPage: true });
    await goto(page, '/me/interviews/new', '.interview-editor'); check(await noOverflow(page), 'Phone editor has no horizontal overflow');
    await page.getByRole('textbox', { name: '问题 1', exact: true }).first().fill('手机端记录的问题');
    await page.getByRole('button', { name: '保存草稿', exact: true }).click(); await page.waitForURL(/\/me\/interviews\/\d+\/edit$/);
    await page.locator('.interview-editor').waitFor(); check(await page.getByRole('textbox', { name: '问题 1', exact: true }).first().inputValue() === '手机端记录的问题', 'Phone draft save retains question');
    await page.screenshot({ path: 'output/playwright/editor-mobile.png', fullPage: true });
    await goto(page, '/interview/123', '.detail-heading'); check(await noOverflow(page), 'Phone detail has no horizontal overflow');
    await goto(page, '/about'); await page.getByText('查看赞赏码').click();
    await page.waitForFunction(() => [...document.querySelectorAll('details img')].every(img => img.complete && img.naturalWidth > 0));
    check(await page.locator('details img').count() === 2, 'Both supplied support resources render');
    check(await noOverflow(page), 'Phone about page with support codes fits viewport');
    await page.screenshot({ path: 'output/playwright/about-mobile.png' });
    await admin.setViewportSize({ width: 375, height: 812 }); await goto(admin, '/admin/reviews/1002');
    await admin.getByText('提交时间').first().waitFor();
    check(await noOverflow(admin), 'Phone review and candidates fit viewport');
    await admin.screenshot({ path: 'output/playwright/review-mobile.png', fullPage: true });
    await page.emulateMedia({ reducedMotion: 'reduce' });
    await goto(page, '/interview/123', '.detail-heading');
    check(await page.locator('.copy-button').first().evaluate(el => getComputedStyle(el).transitionDuration) === '0s', 'Reduced motion disables animation');
    await admin.close();
    return { passed: passed.length, checks: passed };
  } catch (error) { throw new Error(`${step}: ${error.message}`); }
}
