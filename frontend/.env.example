# Real API by default; set true only for frontend-only work with the mock server.
NEXT_PUBLIC_API_MOCK=false
# Empty uses same-origin /api/v1. A separate origin must allow browser CORS.
NEXT_PUBLIC_API_BASE_URL=
# Umami analytics (optional): both must be non-empty to load the tracker; leave empty to disable.
# Script URL, e.g. https://analytics.example.com/script.js; Website ID comes from the Umami dashboard.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
