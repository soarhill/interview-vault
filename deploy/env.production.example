# Interview Vault 生产环境变量模板
# 复制为 deploy/env.production（已被 .gitignore 拦截）并填入真实值。
# 全部变量均为必填：prod profile 下 ProductionConfigGuard 会在启动时
# 拒绝任何开发默认值 / localhost / 空白配置，宁起不来不带病上线。

# ---- 数据库（容器网络内互访，主机名固定为 pg）----
IV_DB_URL=jdbc:postgresql://pg:5432/interviewvault
IV_DB_USER=interviewvault
IV_DB_PASSWORD=<生成一个强密码>

# ---- GitHub OAuth（生产用独立 OAuth App，回调为 https://<域名>/api/v1/auth/github/callback）----
IV_GITHUB_CLIENT_ID=<生产 OAuth App Client ID>
IV_GITHUB_CLIENT_SECRET=<生产 OAuth App Client Secret>

# ---- 管理员 GitHub 数字 ID 白名单（逗号分隔）----
IV_ADMIN_GITHUB_IDS=<你的 GitHub 数字 ID>

# ---- 网络（正式域名确定后填写；当前未备案阶段可先留内网演练值）----
IV_CORS_ORIGINS=https://<域名>
IV_LOGIN_SUCCESS_REDIRECT=https://<域名>
IV_SERVER_PORT=8080

# ---- Compose 编排变量（--env-file 时同时用于插值）----
# 镜像标签：发布用不可变版本号（如 1.0.0 或 1.0.0-cdb51af），回滚 = 改回旧标签
IMAGE_TAG=1.0.0
# 宿主端口：8080/8081 已被既有业务占用，后端固定走 8082；前端 3000
BACKEND_HOST_PORT=8082
FRONTEND_HOST_PORT=3000
# 私有赞赏码目录（服务器上的仓库外路径）
IV_SUPPORT_DIR=./deploy/private-assets/support
# 本文件自身的路径（backend/db-backup 的 env_file）
IV_ENV_FILE=./deploy/env.production
